{
  "name": "@moonsjs/server",
  "version": "0.6.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonsjs/server.git"
  },
  "homepage": "https://github.com/moonsjs/docs",
  "bugs": {
    "url": "https://github.com/moonsjs/server/issues"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "bun": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "prepack": "bun run build",
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && bun build src/index.ts src/client.ts --outdir dist --target node --format esm --splitting --sourcemap=external --external @moonsjs/core --external '@moonsjs/core/*' --external @standard-schema/spec --external devalue",
    "test": "bun test"
  },
  "dependencies": {
    "@moonsjs/core": "^0.6.0",
    "@standard-schema/spec": "^1.1.0",
    "devalue": "^6.0.3"
  },
  "devDependencies": {
    "zod": "^4.6.7",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.3"
  }
}
